+    def _execute_pipelined_loop(self, input_ids, positions, model_kwargs, scheduler_output):
+        """Helper to run the manual layer-by-layer forward pass."""
+        kv_mgr = self.kv_cache_manager
+        model = self.get_model()
+        req_id = scheduler_output.request_id # Simplifying for unique-request test
+        curr_token_idx = self.input_batch.num_computed_tokens_cpu[0]
+
+        # A. Start with Embeddings (Layer -1)
+        # Note: Depending on the model, this is usually model.get_input_embeddings()
+        hidden_states = model.embed_input_ids(input_ids) if input_ids is not None else model_kwargs['inputs_embeds']
+
+        # B. The Handshake Loop
+        # Most vLLM models (Llama, etc) store layers in model.model.layers
+        layers = getattr(model.model, "layers", model.layers)
+
+        for i, layer in enumerate(layers):
+            # 1. WAIT: Sync with PCIe transfer stream
+            kv_mgr.ensure_data_resident(i)
+
+            # 2. REMAP: Update the GPU Block Table to point to the window
+            window_block_id = kv_mgr.hbm_window_blocks[req_id][i % (kv_mgr.K + 1)]
+            self.input_batch.block_table.remap_layer_to_window(i, req_id, window_block_id)
+
+            # 3. COMPUTE: The actual Transformer layer
+            hidden_states = layer(hidden_states, positions=positions, **model_kwargs)
+
+            # 4. SIGNAL: Tell CPU that Layer i is done
+            self.signal_lib.signal_layer_completion(kv_mgr.status_host_buffer.data_ptr(), i)
+
+            # 5. EVICT: Sink the new token into DDR master store
+            kv_mgr.save_new_token_async(req_id, i, curr_token_idx)
+
+        return hidden_states
