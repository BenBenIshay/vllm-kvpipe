+++ b/vllm/v1/worker/gpu/block_table.py
@@ -220,3 +220,19 @@ def _load_ptr(ptr_to_ptr, elem_dtype):
     ptr = tl.load(ptr_to_ptr)
     ptr = tl.cast(ptr, tl.pointer_type(elem_dtype))
     return tl.multiple_of(ptr, 16)
+
+def remap_layer_to_window(self, layer_id: int, request_id: str, window_block_id: int):
+    """
+    Dynamically updates the Block Table for a specific layer.
+    This ensures PagedAttention reads from our sliding window.
+    """
+    # 1. Locate the entry for this request in the GPU-resident Block Table
+    req_idx = self.request_id_to_index[request_id]
+
+    # 2. Update the block ID for the specific layer
+    # In V1, block_tables is often a [Batch, Layers, Max_Blocks] tensor
+    # We overwrite the 'active' block for the specific layer being computed
+    self.block_tables_gpu[req_idx, layer_id, 0] = window_block_id
+
+    # Optional: If using CUDA Graphs, we might need a memory barrier here
+    # torch.cuda.current_stream().wait_stream(torch.cuda.default_stream())
