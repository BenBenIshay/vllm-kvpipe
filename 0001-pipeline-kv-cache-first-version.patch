@@ -483,3 +483,80 @@ class KVCacheManager:
     ) -> KVCacheBlocks:
         # Only create new KVCacheBlocks for non-empty blocks
         return KVCacheBlocks(blocks) if any(blocks) else self.empty_kv_cache_blocks
+
+class PipelinedKVCacheManager(KVCacheManager):
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.K = 2 
+        self.cpu_placeholders = {} 
+        self.hbm_window_blocks = {}
+        self.status_host_buffer = torch.zeros(1, dtype=torch.int32).pin_memory()
+        self.layer_ready_events = [torch.cuda.Event(blocking=False) for _ in range(self.num_layers)]
+        self.transfer_stream = torch.cuda.Stream()
+
+    def allocate_master_cache(self, request_id: str, max_seq_len: int):
+        shape = (self.num_layers, 2, self.num_heads, max_seq_len, self.head_dim)
+        self.cpu_placeholders[request_id] = torch.zeros(shape, dtype=self.dtype, pin_memory=True)
+        self.hbm_window_blocks[request_id] = self.block_allocator.allocate(self.K + 1)
+
+    def initialize_ddr_from_prompt(self, request_id, prompt_tokens):
+        """Pre-populates the DDR master with the initial prompt KV."""
+        # Standard vLLM logic to compute prompt KV and store in self.cpu_placeholders[request_id]
+        pass
+
+#   def trigger_prefetch(self, request_id, layer_id, current_len):
+#       with torch.cuda.stream(self.transfer_stream):
+#           src = self.cpu_placeholders[request_id][layer_id, :, :, :current_len, :]
+#           dst_block_id = self.hbm_window_blocks[request_id][layer_id % (self.K + 1)]
+#           dst = self.get_physical_block_ptr(dst_block_id)
+#           dst[:, :, :current_len, :].copy_(src, non_blocking=True)
+#           self.layer_ready_events[layer_id].record(self.transfer_stream)
+
+def trigger_prefetch(self, request_id: str, layer_id: int, current_len: int):
+    """
+    PREFETCH: Orchestrates the move from CPU DDR Master to GPU HBM Window.
+    Merges PCIe connector logic with sequence-length awareness.
+    """
+    # 1. Enter the dedicated I/O stream to overlap with computation
+    with torch.cuda.stream(self.transfer_stream):
+
+        # 2. SOURCE: Get the history from CPU Pinned Memory
+        # Shape: [2, Heads, current_len, HeadDim]
+        src = self.cpu_placeholders[request_id][layer_id, :, :, :current_len, :]
+
+        # 3. DESTINATION: Find the rotating HBM window slot
+        window_idx = layer_id % (self.K + 1)
+        dst_block_id = self.hbm_window_blocks[request_id][window_idx]
+
+        # 4. ADDRESSING: Get the raw physical pointer in HBM
+        dst = self.get_physical_block_ptr(dst_block_id)
+
+        # 5. EXECUTION: High-speed DMA Transfer over PCIe 5.0
+        # We only copy the tokens generated so far to minimize latency
+        dst[:, :, :current_len, :].copy_(src, non_blocking=True)
+
+        # 6. SYNC MARK: Record the event so the GPU ModelRunner can wait for it
+        self.layer_ready_events[layer_id].record(self.transfer_stream)
+
+    # Logging for debugging the K-window timing
+    if hasattr(self, "logger"):
+        self.logger.debug(f"Prefetch triggered: Layer {layer_id} for len {current_len}")
+    def save_new_token_async(self, request_id, layer_id, token_idx):
+        with torch.cuda.stream(self.transfer_stream):
+            window_idx = layer_id % (self.K + 1)
+            src_block_id = self.hbm_window_blocks[request_id][window_idx]
+            hbm_token = self.get_token_ptr(src_block_id, token_idx)
+            ddr_slot = self.cpu_placeholders[request_id][layer_id, :, :, token_idx, :]
+            ddr_slot.copy_(hbm_token, non_blocking=True)
+
+    def ensure_data_resident(self, layer_id):
+        torch.cuda.current_stream().wait_event(self.layer_ready_events[layer_id])
+
+    def get_gpu_progress(self):
+        return self.status_host_buffer[0].item()
+
+    def get_token_ptr(self, block_id, token_idx):
+        # Pointer arithmetic as defined in previous turn
+        offset = (block_id * self.block_stride) + (token_idx * self.token_stride)
+        return torch.as_tensor(self.gpu_cache_base_ptr + offset, device="cuda")
+
