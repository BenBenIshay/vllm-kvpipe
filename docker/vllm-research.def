# Apptainer definition — mirrors docker-compose.yml service `vllm-research`
# (see ../docker-compose.yml in this repo).
#
# Build (from this directory or pass full path to this file):
#   apptainer build vllm-research.sif docker/vllm-research.def
#
# Interactive shell (typical dev — same binds as compose):
#   apptainer shell --nv \
#     --bind /home/ben/vllm:/workspace/vllm \
#     --bind "${HOME}/.cache/huggingface:/root/.cache/huggingface" \
#     --cwd /workspace/vllm \
#     vllm-research.sif
#
# Do not bake secrets into the SIF. Pass tokens at runtime, e.g.:
#   export HF_TOKEN=...   # or use huggingface-cli login on the host cache dir
#
# Notes vs Docker Compose:
# - `shm_size: 32gb`: Apptainer uses the host’s /dev/shm unless you use --contain;
#   for huge IPC needs, ask your admin or use --writable-tmpfs with care.
# - `ulimits` (memlock, stack): set in the shell before apptainer if your site allows
#   (e.g. ulimit -l unlimited).
# - `restart: always`: use a process supervisor or systemd on the host; not in .def.

Bootstrap: docker
From: vllm/vllm-openai:latest

%help
    vllm-research: idle research container matching docker-compose.yml (vllm-research service).
    Build: apptainer build vllm-research.sif docker/vllm-research.def
    See repository docker-compose.yml for intended volume and environment parity.

%labels
    REPO vllm
    COMPOSE_SERVICE vllm-research

%environment
    export NVIDIA_VISIBLE_DEVICES=all
    export NVIDIA_DRIVER_CAPABILITIES=compute,utility
    export VLLM_GPU_MEMORY_UTILIZATION=0.90
    export HF_HOME=/root/.cache/huggingface

%runscript
    # Same idea as compose `entrypoint: ["tail", "-f", "/dev/null"]` — block and stay alive.
    exec tail -f /dev/null
